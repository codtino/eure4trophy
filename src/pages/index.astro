---
import Base from '../layouts/Base.astro';
import Photo from '../components/Photo.astro';
import Progression from '../components/Progression.astro';
import Icon from '../components/Icon.astro';
import site from '../site.config.js';
import { url } from '../lib/url.js';

const a = site.accueil;
---
<Base>
  <!-- Héros -->
  <section class="heros">
    <div class="conteneur heros__grille">
      <div class="heros__texte">
        <p class="surtitre">{a.surtitre}</p>
        <h1>{a.titre}</h1>
        <p class="chapo">{a.intro}</p>
        <div class="boutons">
          <a class="bouton" href={url('faire-un-don/')}><Icon name="heart" /> Faire un don</a>
          <a class="bouton bouton--clair" href={url('devenir-sponsor/')}><Icon name="megaphone" /> Devenir sponsor</a>
        </div>
      </div>
      <div class="heros__visuel">
        <Photo src={site.equipage.photo} alt={site.equipage.photoAlt} ratio="4 / 5" eager />
        <img class="heros__badge" src={url('assets/logo-160.png')} alt="" width="120" height="120" />
      </div>
    </div>
  </section>

  <!-- Chiffres clés -->
  <section class="section section--serree" aria-labelledby="titre-chiffres">
    <div class="conteneur">
      <h2 id="titre-chiffres" class="sr-only">Le 4L Trophy en chiffres</h2>
      <ul class="chiffres">
        {a.chiffres.map((c) => (
          <li>
            <span class="chiffres__valeur">{c.valeur}</span>
            <span class="chiffres__label">{c.label}</span>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <!-- Où en est-on ? -->
  <section class="section section--bandes sombre" aria-labelledby="titre-progression">
    <div class="bandes" aria-hidden="true"></div>
    <div class="conteneur progression-bloc">
      <div>
        <p class="surtitre">Objectif financement</p>
        <h2 id="titre-progression">Où en est-on ?</h2>
        <p>Achat et préparation de la 4L, inscription, carburant, actions solidaires : chaque contribution compte.</p>
        <a class="bouton" href={url('faire-un-don/')}>Je fais avancer la 4L <Icon name="arrow" /></a>
      </div>
      <Progression />
    </div>
  </section>

  <!-- L'équipage -->
  <section class="section" aria-labelledby="titre-equipage">
    <div class="conteneur">
      <p class="surtitre">Qui sommes-nous ?</p>
      <h2 id="titre-equipage">{a.equipageTitre}</h2>
      <p class="chapo">{a.equipageIntro}</p>
      <div class="grille grille--2 equipage">
        {site.equipage.membres.map((m) => (
          <article class="carte membre">
            <Photo src={m.photo} alt={m.photoAlt} ratio="1 / 1" ronde class="membre__photo" />
            <div>
              <h3>{m.prenom} <span class="membre__surnom">« {m.surnom} »</span></h3>
              <p>{m.resume}</p>
            </div>
          </article>
        ))}
      </div>
      <p><a href={url('notre-projet/')}>Découvrir notre projet en détail <Icon name="arrow" class="icone-lien" /></a></p>
    </div>
  </section>

  <!-- Héritage + Instagram -->
  <section class="section section--serree">
    <div class="conteneur">
      <div class="carte heritage">
        <div>
          <h2>{a.heritageTitre}</h2>
          <p>{a.heritage}</p>
        </div>
        <div class="heritage__insta">
          <p>Suivez la préparation de la 4L au jour le jour :</p>
          <a class="bouton bouton--clair" href={site.instagram.lien} target="_blank" rel="noopener">
            <Icon name="instagram" /> @{site.instagram.pseudo}<span class="sr-only"> sur Instagram (nouvel onglet)</span>
          </a>
        </div>
      </div>
    </div>
  </section>
</Base>

<style>
  .heros { padding: clamp(32px, 6vw, 72px) 0 clamp(48px, 7vw, 88px); overflow: hidden; }
  .heros__grille { display: grid; gap: 40px; align-items: center; }
  @media (min-width: 900px) { .heros__grille { grid-template-columns: 1.15fr 0.85fr; gap: 56px; } }
  .heros h1 { margin-bottom: 0.4em; }
  .heros .chapo { margin-bottom: 1.6em; }
  .heros__visuel { position: relative; max-width: 440px; width: 100%; justify-self: center; margin-right: 20px; }
  .heros__visuel :global(.photo) { transform: rotate(2deg); }
  .heros__badge {
    position: absolute; left: -20px; bottom: -28px;
    width: clamp(88px, 22vw, 120px); height: auto;
    transform: rotate(-10deg);
    filter: drop-shadow(3px 3px 0 var(--nuit));
  }

  .chiffres {
    list-style: none; margin: 0; padding: 0;
    display: grid; grid-template-columns: repeat(2, 1fr); gap: 14px;
  }
  @media (min-width: 800px) { .chiffres { grid-template-columns: repeat(4, 1fr); } }
  .chiffres li {
    border-top: 3px solid var(--nuit);
    padding-top: 12px;
  }
  .chiffres__valeur { display: block; font-family: var(--f-titre); font-size: clamp(1.5rem, 4.5vw, 2.2rem); color: var(--orange-texte); line-height: 1.1; }
  .chiffres__label { font-weight: 500; }

  .progression-bloc { display: grid; gap: 40px; align-items: center; }
  @media (min-width: 900px) { .progression-bloc { grid-template-columns: 0.9fr 1.1fr; gap: 64px; } }

  .equipage { margin: 32px 0 28px; }
  .membre { flex-direction: row; align-items: center; gap: 20px; }
  .membre :global(.membre__photo) { flex: none; width: clamp(96px, 26vw, 140px); box-shadow: 3px 3px 0 var(--nuit); }
  .membre h3 { font-size: 1.4rem; }
  .membre__surnom { color: var(--orange-texte); font-size: 0.8em; }
  .membre p { margin: 0; }
  :global(.icone-lien) { width: 18px; height: 18px; vertical-align: -3px; }

  .heritage { display: grid; gap: 24px; background: var(--sable-clair); }
  @media (min-width: 900px) { .heritage { grid-template-columns: 1.5fr 1fr; align-items: center; gap: 48px; } }
  .heritage h2 { font-size: clamp(1.5rem, 3.5vw, 2rem); }
  .heritage__insta p { font-weight: 500; }
</style>
